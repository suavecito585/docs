  "keyFeatures": [
    "Send and read Discord messages from any MCP-compatible AI assistant",
    "Manage channels, categories, forum posts, and threads",
    "Full role and member management",
    "Webhook create, send, edit, and delete",
    "Message reactions (single, multiple, remove)",
    "Advanced message search with filters",
    "Date-based message filtering with snowflake ID or ISO 8601 support",
    "Stdio and Streamable HTTP transport modes",
    "Docker and NPX installation options",
    "Compatible with Claude Desktop, Cursor, Windsurf, and any MCP client"
  ],
